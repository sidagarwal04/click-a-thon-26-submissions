ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zentra_app:zentra_app@localhost:5432/zentra_control
DATABASE_OWNER_URL=postgresql+psycopg://zentra_owner:zentra_owner@localhost:5432/zentra_control
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=zentra_audit_app
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=zentra_audit
CLICKHOUSE_SECURE=false
CUBE_URL=http://localhost:4000
CUBE_API_SECRET=
# Cube's Node process calling back into this API for a tenant's model and
# ClickHouse credentials. Must match the Cube container's value; without
# it the internal endpoint answers 503 and no connected table is ever
# compiled into a cube.
CUBE_INTERNAL_API_SECRET=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
E2B_API_KEY=
FRONTEND_ORIGIN=http://localhost:4200
ANTHROPIC_API_KEY=
# Optional. A provider with no key is skipped in the routing chain.
OPENAI_API_KEY=
GEMINI_API_KEY=
# NVIDIA NIM key, format nvapi-... from build.nvidia.com
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional terminal presentation. Findings remain available when unset.
THESYS_API_KEY=
THESYS_MODEL=c1/anthropic/claude-sonnet-4/v-20251230
THESYS_INPUT_PRICE_PER_MILLION=3
THESYS_OUTPUT_PRICE_PER_MILLION=15
EXECUTION_WORKER_ENABLED=true
EXECUTION_WORKER_ID=

# Hex-encoded AES key (32 bytes) sealing connector source credentials.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Unset means the Connector API answers 503 rather than storing unsealed secrets.
CONNECTOR_CREDENTIAL_KEY=
