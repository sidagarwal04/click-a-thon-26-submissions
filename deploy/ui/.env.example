# Azure Blob Storage (private container; the service creates read-only SAS URLs)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_KEY=replace-me
AZURE_STORAGE_CONTAINER=investigations

# ClickHouse
CLICKHOUSE_DSN=
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=default

# LibreChat's native agent runtime is required for Supervisor + Subagents.
LIBRECHAT_NATIVE_URL=https://clickathon26librechat.nannan.in
LIBRECHAT_NATIVE_EMAIL=service-account@example.com
LIBRECHAT_WORKFLOW_AGENT_ID=agent_replace_me
# Shared only with the private LibreChat runtime data MCP; generated on deploy.
INVESTIGATION_RUNTIME_TOKEN=replace-me

MAX_UPLOAD_BYTES=268435456
SAS_TTL_MINUTES=30
POLL_INTERVAL_SECONDS=2

# VM deployment (kept only in the ignored .env file)
SSH_TARGET=azureuser@172.175.64.67
SSH_PASSWORD=replace-me
REMOTE_DIR=/opt/clickathon-investigations
